# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase - use a different project for each environment
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Google OAuth remains disabled until GLB-E02 provides these values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Email SMTP
# - Local (Mailpit bawaan Supabase CLI, UI http://127.0.0.1:54324):
#     SMTP_HOST=127.0.0.1
#     SMTP_PORT=54325
#     SMTP_SECURE=false
#     SMTP_USER=
#     SMTP_PASS=
# - Production / Staging (Brevo SMTP Relay):
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_SECURE=false
#     SMTP_USER=<your_brevo_smtp_login_email>
#     SMTP_PASS=<your_brevo_smtp_master_key>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Glubee
SMTP_FROM_EMAIL=no-reply@glubee.id
SMTP_REPLY_TO=support@glubee.id

# Brevo API Key (jika memakai REST API Brevo selain SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@glubee.id

# Scheduled jobs
CRON_SECRET=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
