# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase - use a different project for each environment
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Google OAuth remains disabled until GLB-E02 provides these values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Email SMTP
# - Local (Mailpit bawaan Supabase CLI, UI http://127.0.0.1:54324):
#     SMTP_HOST=127.0.0.1
#     SMTP_PORT=54325
#     SMTP_SECURE=false
#     SMTP_USER=
#     SMTP_PASS=
# - Production / Staging (Brevo SMTP Relay):
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_SECURE=false
#     SMTP_USER=<your_brevo_smtp_login_email>
#     SMTP_PASS=<your_brevo_smtp_master_key>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Glubee
SMTP_FROM_EMAIL=no-reply@glubee.id
SMTP_REPLY_TO=glubeebuddy@gmail.com

# Brevo API Key (jika memakai REST API Brevo selain SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@glubee.id

# Scheduled jobs: CRON_SECRET minimal 32 karakter (openssl rand -hex 24); kosong = endpoint internal mati.
CRON_SECRET=
# Pengingat jadwal via email (GLB-019). Production: false sampai uji kolektif.
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_DAILY_CAP=150

# Web Push (GLB-020). Lokal: bunx web-push generate-vapid-keys
REMINDER_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:glubeebuddy@gmail.com

# Enkripsi field push/kontak di aplikasi: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Akun demo LOKAL saja (Supabase lokal, data sintetis). Jangan dipakai di production.
# Buat/isi: bun scripts/demo-data.ts --create-local
DEMO_EMAIL=demo@glubee.test
DEMO_PASSWORD=Demo-lokal-Glubee-2026
