# Salin ke /opt/glubee/.env lalu `chmod 600 .env`. Jangan commit file hasil salinan.
# Cara membuat secret dan key: lihat deploy/README.md.

# ---- URL ----
SITE_URL=https://glubee.id
API_EXTERNAL_URL=https://api.glubee.id
API_HOSTNAME=api.glubee.id

# ---- Image aplikasi (diisi workflow deploy; default latest) ----
APP_TAG=latest

# ---- Database ----
POSTGRES_PASSWORD=

# ---- JWT (model lama HS256; wajib karena tanpa gateway) ----
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- SMTP Brevo (dipakai GoTrue dan aplikasi) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Glubee
SMTP_FROM_EMAIL=no-reply@glubee.id
SMTP_REPLY_TO=glubeebuddy@gmail.com

# ---- Google OAuth (aktifkan setelah redirect URI terdaftar di Google Cloud Console) ----
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Aplikasi ----
CRON_SECRET=
# Pengingat jadwal (GLB-019): false sampai uji kolektif.
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_DAILY_CAP=150
# Browser push (GLB-020): false sampai uji kolektif. Kunci VAPID berbeda per lingkungan (lihat README).
REMINDER_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:glubeebuddy@gmail.com
# Undangan kontak darurat (GLB-021): false sampai uji kolektif; memakai kuota Brevo.
CONTACT_INVITES_ENABLED=false
# 32 byte base64 (generate-keys.sh). Simpan juga di password manager: tanpa kunci ini
# subscription push dan email kontak darurat di backup tidak bisa dibaca.
DATA_ENCRYPTION_KEY=

# ---- Backup (Tahap 5, deploy/backup/backup.sh) ----
# Public key age saja; private key disimpan di password manager, tidak pernah di VPS.
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=gdrive
BACKUP_KEEP=7
BACKUP_DB_CONTAINER=glubee-db-1
HC_PING_URL=

# ---- Port host (semua bind 127.0.0.1); samakan dengan template nginx bila diubah ----
DB_HOST_PORT=54329
AUTH_HOST_PORT=9999
REST_HOST_PORT=3001
APP_HOST_PORT=3000
GLUBEE_SUBNET=172.30.10.0/24
